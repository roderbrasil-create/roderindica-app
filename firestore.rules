rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // QUEM É QUEM (19/10/2026)
    // Antes, todas as funções de papel respondiam "true": qualquer pessoa logada,
    // inclusive o visitante anônimo das páginas públicas, podia se fazer admin,
    // ler a senha do e-mail e mexer em comissão. Agora o papel vem do cadastro
    // do usuário (users/{uid}.role), que ele mesmo não consegue mais trocar.
    // ===============================================================

    function isAuthenticated() {
      return request.auth != null;
    }

    // Login de verdade. As páginas públicas (estoque, feira) entram anônimas.
    function naoAnonimo() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function emailDoToken() {
      return string(request.auth.token.get('email', '')).lower();
    }

    // E-mail confiável: só o CONFIRMADO (19/10/2026). Antes a conta com senha valia sozinha,
    // mas o cadastro de usuário fica ligado no Firebase (o app usa login anônimo), e qualquer um
    // criava qualquer@roderbrasil.com.br com senha pela API e passava por equipe. As contas com
    // senha da tela de Usuários nascem confirmadas pelo servidor.
    function emailVerificado() {
      return naoAnonimo() && emailDoToken() != '' &&
        request.auth.token.get('email_verified', false) == true;
    }

    // Diretoria reconhecida pelo e-mail confirmado (mesma lista do app).
    function diretoria() {
      return emailVerificado() && emailDoToken() in [
        'roderbrasil@gmail.com', 'roderindica@gmail.com', 'jeferson@roderbrasil.com.br'
      ];
    }

    function papel() {
      return naoAnonimo() && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('role', '')
        : '';
    }

    function hasRole(role) {
      return papel() == role;
    }

    function isAdmin() {
      return diretoria() || papel() == 'admin';
    }

    function isManager() {
      return isAdmin() || papel() == 'manager';
    }

    function isTriagem() {
      return papel() == 'triagem';
    }

    function isMarketing() {
      return isAdmin() || papel() == 'marketing';
    }

    function isFinanceiro() {
      return papel() in ['financial', 'finance', 'fiscal'];
    }

    // Equipe interna da Roder: quem trabalha a venda por dentro.
    function isInternalSeller() {
      return isManager() || papel() in ['internal_seller', 'triagem'];
    }

    // Qualquer pessoa da Roder (não parceiro, não visitante).
    function isEquipe() {
      return isInternalSeller() || isFinanceiro() || papel() in ['marketing', 'assistant'] ||
        (emailVerificado() && emailDoToken().matches('.*@roderbrasil[.]com[.]br$'));
    }

    // A indicação é de quem está lendo. resource.data.get() porque indicação antiga não tem
    // todos os campos, e campo ausente não pode virar erro na regra.
    function donoDaIndicacao() {
      return naoAnonimo() && (
        resource.data.get('external_seller_uid', '') == request.auth.uid ||
        resource.data.get('created_by', '') == request.auth.uid ||
        resource.data.get('user_id', '') == request.auth.uid ||
        resource.data.get('indicator_uid', '') == request.auth.uid ||
        resource.data.get('standard_seller_uid', '') == request.auth.uid ||
        resource.data.get('partner_id', '') == request.auth.uid ||
        (emailVerificado() && resource.data.get('external_seller_email', '') == emailDoToken())
      );
    }

    function isParceiro() {
      return papel() in ['external_seller', 'vendedor_padrao'];
    }

    // Campos de poder no cadastro do usuário: só admin muda.
    function naoMexeEmPoder() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(
        ['role', 'permissions', 'status', 'is_commissionable', 'commission_rate', 'is_lead_receiver', 'uid']);
    }

    // CADASTRO FORJADO (19/10/2026). O próprio cadastro não pode levar senha inicial nem o e-mail de
    // outra pessoa: a conta B gravava em users/{B} o e-mail de A, uma senha inicial e uma data
    // antiga, e o primeiro acesso de A (criada por fora) confirmava o e-mail dela no servidor.
    // A senha inicial é coisa da tela de Usuários (gestão) e a data, só do servidor.
    function emailDoCadastroEhODoLogin(e) {
      return e == '' || e == emailDoToken();
    }
    // E-MAIL NO CADASTRO SÓ COM LOGIN CONFIRMADO (20/10/2026). Conta com senha criada por fora não
    // confirma e-mail nenhum, mas o cadastro de usuário fica aberto no Firebase: a conta Q gravava
    // users/Q com o e-mail de outra pessoa (X), com taxa de comissão e "recebe lead" à sua escolha,
    // e o primeiro acesso de X juntava esse cadastro como se fosse pré-cadastro da gestão. Agora o
    // cadastro próprio só carrega e-mail se o login o confirmou (Google, por exemplo); sem
    // confirmação nasce sem e-mail, e o primeiro acesso pelo servidor cuida do resto.
    function emailDoCadastroEhODoLogin(e) {
      return e == '' || (e == emailDoToken() && emailVerificado());
    }
    // Poder não se cria sozinho: taxa, comissionável e "recebe lead" são da gestão.
    function cadastroProprioSemSenhaNemEmailAlheio() {
      return !request.resource.data.keys().hasAny(['initial_password', 'initial_password_set_at',
          'commission_rate', 'is_commissionable', 'is_lead_receiver']) &&
        emailDoCadastroEhODoLogin(string(request.resource.data.get('email', '')).lower());
    }
    function edicaoPropriaSemSenhaNemEmailAlheio() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny(['initial_password', 'initial_password_set_at']) &&
        (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['email']) ||
         emailDoCadastroEhODoLogin(string(request.resource.data.get('email', '')).lower()));
    }

    // ===============================================================
    // Regras
    // ===============================================================

    match /users/{userId} {
      allow get: if isOwner(userId) || isEquipe();
      // pelo e-mail, só confirmado: senão quem criasse a conta do e-mail de um pré-cadastrado lia
      // o cadastro dele (telefone, PIX, senha inicial)
      allow list: if isEquipe() ||
        (emailVerificado() && resource.data.email == request.auth.token.email);
      // Cadastro próprio nasce sem poder. O primeiro acesso de quem foi pré-cadastrado
      // é feito pelo servidor (/api/auth/reivindicar-perfil).
      allow create: if isAdmin() ||
        ((isManager() || isTriagem()) && papelQueGestaoDa(request.resource.data.get('role', '')) &&
         !('initial_password_set_at' in request.resource.data)) ||
        (isOwner(userId) && naoAnonimo() &&
         request.resource.data.get('role', 'external_seller') in ['external_seller', 'vendedor_padrao', ''] &&
         request.resource.data.get('status', 'pending') in ['pending', ''] &&
         !('permissions' in request.resource.data) &&
         cadastroProprioSemSenhaNemEmailAlheio());
      allow update: if isAdmin() ||
        // gerente e triagem cuidam da equipe (férias, recebe lead, dados), sem promover a gestão
        // e sem mexer no próprio papel
        ((isManager() || isTriagem()) && !isOwner(userId) &&
         papelQueGestaoDa(resource.data.get('role', '')) &&
         papelQueGestaoDa(request.resource.data.get('role', '')) &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['initial_password_set_at'])) ||
        (isOwner(userId) && naoMexeEmPoder() && edicaoPropriaSemSenhaNemEmailAlheio()) ||
        // a triagem liga "recebe lead" e marca férias de qualquer um da equipe, inclusive gestão
        ((isManager() || isTriagem()) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(
           ['is_lead_receiver', 'vacation_start', 'vacation_end', 'updated_at']));
      allow delete: if isAdmin() ||
        ((isManager() || isTriagem()) && papelQueGestaoDa(resource.data.get('role', '')));

      function papelQueGestaoDa(r) {
        return r in ['external_seller', 'vendedor_padrao', 'internal_seller', 'triagem', 'financial',
                     'finance', 'fiscal', 'marketing', 'assistant', ''];
      }
    }

    match /indications/{indicationId} {
      // A equipe lê tudo. O parceiro (e qualquer outro login) lê só a indicação que é DELE:
      // pelo uid em um dos campos de dono, ou pelo e-mail do login (só confirmado). Antes qualquer login lia todas, e um parceiro via as indicações dos outros
      // abrindo o Firestore direto. A tela do parceiro busca exatamente por estes campos
      // (src/lib/filtrosParceiro.ts), senão o Firebase recusa a consulta inteira.
      allow read: if isEquipe() || donoDaIndicacao();
      // O pedido de orçamento do site e o tablet da feira criam sem login.
      // Sem login só nasce lead novo, nunca venda pronta com comissão.
      allow create: if isEquipe() ||
        (request.resource.data.get('status', 'pending') in ['pending', 'negotiating', 'new', 'triagem'] &&
         !request.resource.data.keys().hasAny(['sale_value', 'commission_value', 'base_commission_value', 'commission_rate_applied']));
      allow update: if isEquipe() ||
        (isParceiro() && resource.data.get('external_seller_uid', '') == request.auth.uid &&
         resource.data.status == 'pending' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(
           ['status', 'external_seller_uid', 'internal_seller_uid', 'base_commission_value',
            'commission_rate_applied', 'commission_value', 'sale_value']));
      allow delete: if isManager();
    }

    match /notifications/{notifId} {
      allow read: if isOwner(resource.data.user_uid) || isManager();
      allow create: if isAuthenticated();
      allow update: if isManager() || (isOwner(resource.data.user_uid) &&
                      request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']));
      allow delete: if isOwner(resource.data.user_uid) || isManager();
    }

    match /leads/{leadId} {
      allow read, write: if isInternalSeller() || (naoAnonimo() && resource.data.user_uid == request.auth.uid);
    }

    match /referring_clients/{clientId} {
      allow read, write: if naoAnonimo();
    }

    match /audit_logs/{logId} {
      allow read: if isManager();
      allow create: if naoAnonimo();
      allow update, delete: if isAdmin();
    }

    match /financial_consultations/{consultId} {
      allow read, write: if isEquipe();
    }

    match /credit_cleared_documents/{docId} {
      allow read: if isEquipe();
      allow write: if isInternalSeller() || isFinanceiro();
    }

    match /commissions/{commissionId} {
      allow read: if isEquipe() ||
        (naoAnonimo() && resource.data.external_seller_uid == request.auth.uid);
      allow create: if isInternalSeller() || isFinanceiro();
      allow update: if isManager() || isFinanceiro() || isInternalSeller() ||
        // o parceiro só anexa a nota e passa para "aguardando pagamento"
        (naoAnonimo() && resource.data.external_seller_uid == request.auth.uid &&
         resource.data.get('status', '') != 'paid' &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['nf_url', 'nf_uploaded_at', 'updated_at', 'status']) &&
         request.resource.data.get('status', '') in [resource.data.get('status', ''), 'waiting_payment']);
      allow delete: if isManager() || isFinanceiro() || isInternalSeller();
    }

    match /products/{productId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /accessories/{accessoryId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /installation_kits/{kitId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /endomarketing_actions/{actionId} {
      allow read: if isEquipe();
      allow create, update: if isManager() || isMarketing() || isFinanceiro();
      allow delete: if isManager() || isFinanceiro();

      match /financial_items/{itemId} {
        allow read: if isEquipe();
        allow write: if isManager() || isMarketing() || isFinanceiro();
      }

      match /evidence/{evidenceId} {
        allow read: if isEquipe();
        allow write: if isManager() || isMarketing() || isFinanceiro();
      }
    }

    match /endomarketing_financial_categories/{categoryId} {
      allow read: if isEquipe();
      allow write: if isEquipe();
    }

    // Fotos do catálogo: todo mundo vê, só a equipe troca.
    match /app_files/{fileId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /fae_technical_delivery_form/{modelId} {
      allow read, write: if true;
    }

    match /stock_items/{itemId} {
      allow read: if true;
      allow create: if isEquipe();
      allow delete: if isManager();
      allow update: if isEquipe();
    }

    match /stock_sales/{saleId} {
      allow read: if naoAnonimo();
      allow create, update, delete: if isEquipe();
    }

    match /stock_reservations/{resId} {
      allow read: if true;
      allow create: if true;
      allow update: if isEquipe() || (naoAnonimo() && resource.data.seller_uid == request.auth.uid);
      allow delete: if isManager();
    }

    match /stock_imports_fae/{itemId} {
      allow read: if true;
      allow create, delete: if isManager();
      allow update: if isEquipe();
    }

    match /registered_products/{productId} {
      allow read: if true;
      allow write: if isEquipe();
    }

    match /edge_nodes/{nodeId} {
      allow read, write: if naoAnonimo();
    }

    match /customers/{customerId} {
      allow read, create, update: if isEquipe();
      allow delete: if isInternalSeller();
    }

    match /fairs/{fairId} {
      allow read: if true;
      allow create: if isManager() || isMarketing() || isFinanceiro();
      allow delete: if isManager() || isMarketing();
      allow update: if isEquipe();
    }

    // Configurações. A do e-mail (senha do Gmail) e a do Agendor (token) só o admin lê.
    match /settings/{docId} {
      allow read: if (docId in ['email', 'agendor']) ? isAdmin() :
        (naoAnonimo() || docId.matches('^(engate_rapido|garra_estufagem|high_tip).*'));
      allow write: if isAdmin() ||
        (isEquipe() &&
         (docId in ['comercial_config', 'high_tip_drawing', 'goals', 'notifications'] ||
          docId.matches('^(engate_rapido_ficha_|garra_estufagem_ficha_).*')));
    }

    // Avaliação de cliente: o cliente cria pelo link; ninguém de fora altera.
    match /customer_evaluations/{evaluationId} {
      allow read: if true;
      allow create: if true;
      // a equipe cria a pesquisa antes e o cliente responde por cima, uma vez só
      allow update: if isEquipe() ||
        (resource.data.get('status', '') != 'completed' &&
         !request.resource.data.diff(resource.data).affectedKeys().hasAny(['seller_uid', 'created_by']) &&
         request.resource.data.get('indication_id', '') in [resource.data.get('indication_id', ''), evaluationId]);
      allow delete: if isManager();
    }

    // Leads de feira: o tablet cria sem login; ler e mexer, só a equipe.
    match /fair_leads/{leadId} {
      allow create: if isAuthenticated();
      // quem atendeu (tablet ou vendedor) mexe nos próprios atendimentos; a equipe em todos
      allow read, delete: if isEquipe() ||
        (isAuthenticated() && resource.data.get('salesperson_uid', '') == request.auth.uid);
      allow update: if isEquipe() ||
        (isAuthenticated() && resource.data.get('salesperson_uid', '') == request.auth.uid &&
         request.resource.data.get('salesperson_uid', '') == request.auth.uid);
    }

    match /fair_checklist/{itemId} {
      allow read: if isEquipe();
      allow write: if isEquipe();
    }

    match /fair_checklist_template/{itemId} {
      allow read: if isEquipe();
      allow write: if isMarketing();
    }

    match /fair_expenses/{expenseId} {
      allow read: if isEquipe();
      allow write: if isManager() || isFinanceiro() || isMarketing();
    }

    match /fair_expense_categories/{categoryId} {
      allow read: if isEquipe();
      allow write: if isManager() || isFinanceiro() || isMarketing();
    }

    match /fair_assets/{assetId} {
      allow read: if isEquipe();
      allow write: if isEquipe();
    }

    match /trash_bin/{docId} {
      allow read: if isManager() || isMarketing();
      allow create: if naoAnonimo();
      allow update, delete: if isManager() || isMarketing();
    }

    match /financial_dashboard_months/{monthId} {
      allow read, write: if isManager() || isFinanceiro();
    }

    // Extratos mensais: cada parceiro lê o dele; a equipe lê todos.
    match /monthly_statements/{statementId} {
      allow read: if isEquipe() ||
        (naoAnonimo() && resource.data.seller_uid == request.auth.uid);
      allow write: if isManager() || isFinanceiro() || isTriagem();
      // o parceiro manda a nota do próprio mês: cria ou atualiza o extrato dele como
      // "aguardando pagamento", sem mudar o valor de um extrato que já existe
      allow create: if naoAnonimo() && statementId.matches('^' + request.auth.uid + '_.*') &&
        request.resource.data.seller_uid == request.auth.uid &&
        request.resource.data.status == 'waiting_payment';
      allow update: if naoAnonimo() && resource.data.seller_uid == request.auth.uid &&
        resource.data.get('status', '') != 'paid' &&
        request.resource.data.seller_uid == request.auth.uid &&
        request.resource.data.status == 'waiting_payment' &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(['total_value', 'commission_ids']);
    }

    match /equipment_dossiers/{dossierId} {
      allow read: if isEquipe();
      allow write: if isManager();
    }

    // Perguntas ao Consultor: quem pergunta registra; melhorar a resposta
    // (que passa a valer para todo mundo) é só da gestão.
    match /roder_ai_questions/{questionId} {
      allow read: if isEquipe();
      allow create: if isInternalSeller() ||
        (isAuthenticated() && request.resource.data.get('isImproved', false) != true &&
         !('improvedAnswer' in request.resource.data));
      allow update: if isInternalSeller() ||
        (isEquipe() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isImproved', 'improvedAnswer']));
      allow delete: if isManager();
    }

    match /roder_ai_daily_summaries/{summaryId} {
      allow read, write: if isManager();
    }

    match /approval_queue/{approvalId} {
      allow read, write: if isEquipe();
    }

    match /roder_comercial_guidelines/{guidelineId} {
      allow read: if naoAnonimo();
      allow write: if isInternalSeller();
    }

    // Biblioteca de vídeos do consultor (19/10/2026). A equipe lê aqui; o parceiro e o visitante
    // recebem a lista pelo servidor (GET /api/consultor/videos), só com os campos públicos.
    // Cadastram admin, gerência e marketing (Franciele).
    match /consultor_videos/{videoId} {
      allow read: if isEquipe();
      allow create, update: if (isManager() || isMarketing()) && videoValido(request.resource.data);
      allow delete: if isManager() || isMarketing();

      function videoValido(d) {
        return d.get('tipo', '') in ['campo', 'marketing', 'instalacao'] &&
          d.get('produto_id', '') is string && d.get('produto_id', '').size() > 0 &&
          d.get('video_url', '') is string && d.get('video_url', '').size() > 0 && d.get('video_url', '').size() <= 2000 &&
          d.get('titulo', '') is string && d.get('titulo', '').size() <= 80 &&
          d.get('contexto', '') is string && d.get('contexto', '').size() <= 400;
      }
    }

    match /api_keys/{keyId} {
      allow read, write: if isAdmin();
    }
  }
}
