# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# FIREBASE_SERVICE_ACCOUNT: Optional. A stringified JSON or base64 string of the Firebase Service Account JSON key.
# Required for running administrative/auth actions (like setting passwords manually) outside of Google Cloud (e.g. Hostinger).
FIREBASE_SERVICE_ACCOUNT=

# Hostinger SMTP Fallback: Optional. If configured, Hostinger can send emails instantly
# without needing any database queries or Firebase Service Account file.
SMTP_PROVIDER=gmail
SMTP_USER=
SMTP_PASS=
SMTP_SENDER_EMAIL=


# Integração com o CRM do Roder Vision (docs/integracao-crm.md). Tudo desligado por padrão.
# CRM_ATIVO: 1 liga a integração (a virada): laço de indicações novas, fase 2 e endpoint de eventos. Qualquer outro valor mantém o comportamento atual.
# A carga inicial (tela Admin) só precisa de CRM_CHAVE e pode rodar antes, com CRM_ATIVO vazio.
CRM_ATIVO=
# CRM_CHAVE: chave que o Indica envia no cabeçalho x-roder-chave ao mandar indicações. Use a chave de TESTE em testes.
CRM_CHAVE=
# CRM_SEGREDO: segredo da assinatura (HMAC) dos eventos que o CRM envia para /api/crm/eventos.
CRM_SEGREDO=
# CRM_URL: opcional. Padrão: https://roder-vision.lovable.app/api/public/hooks/crm-entrada
CRM_URL=
# CRM_ATIVO_DESDE: opcional, data ISO da virada. Sem ela, vale a gravada em settings/crm_integracao.ativo_desde
# (se a carga inicial já rodou, é o início dela; senão, o momento da primeira rodada com CRM_ATIVO=1).
CRM_ATIVO_DESDE=
# CRM_NOTIFICAR_EMAIL: opcional, vai no campo notificar_email das indicações novas.
CRM_NOTIFICAR_EMAIL=
