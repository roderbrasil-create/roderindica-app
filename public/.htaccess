# Configuração Apache / Hostinger para direcionamento correto ao Node.js / SPA
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # Permitir acesso direto a uploads e assets estáticos existentes
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Se a requisição não for um arquivo existente, redirecionar para a aplicação
    RewriteRule ^index\.html$ - [L]
    RewriteRule . /index.html [L]
</IfModule>
