rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    function logado() {
      return request.auth != null && request.auth.token.firebase.sign_in_provider != 'anonymous';
    }

    // Equipe Roder pelo e-mail @roderbrasil.com.br. (O app usa um banco NOMEADO do Firestore,
    // e a consulta de papel daqui só enxerga o banco padrão; por isso o papel não entra aqui.)
    // Quem não é da equipe por e-mail continua lendo e enviando arquivo novo normalmente;
    // só não troca nem apaga arquivo que já existe.
    function equipe() {
      return logado() && request.auth.token.get('email_verified', false) == true &&
        string(request.auth.token.get('email', '')).lower().matches('.*@roderbrasil[.]com[.]br$');
    }

    function tamanhoOk(mb) {
      return request.resource == null || request.resource.size < mb * 1024 * 1024;
    }

    // Fotos do tablet da feira: o tablet entra anônimo, então pode só ENVIAR foto nova.
    match /fair_leads/{fairId}/{allPaths=**} {
      allow create: if request.auth != null && tamanhoOk(20) && (resource == null || equipe());
      allow read: if request.auth != null;
      allow update, delete: if equipe();
    }

    // Foto de perfil: cada um troca a própria (o caminho é sempre o mesmo)
    match /profiles/{dono} {
      allow read: if logado();
      allow write: if logado() && request.auth.uid == dono && tamanhoOk(20);
    }

    // Nota fiscal de comissão: o parceiro envia só a dele (o nome começa com monthly_<uid>_).
    match /commissions_nf/{arquivo} {
      allow read: if logado();
      allow create: if logado() && tamanhoOk(30) &&
        (equipe() || (resource == null && arquivo.matches('^monthly_' + request.auth.uid + '_.*')));
      allow update, delete: if equipe();
    }

    // Biblioteca de vídeos do consultor: só a equipe sobe, troca e apaga; vídeo até 80 MB, só mp4,
    // webm ou mov; a capa (quadro tirado do vídeo no celular) até 2 MB, só imagem.
    // A conta com senha conta como equipe pelo e-mail @roderbrasil (o cadastro público fica
    // desligado: conta com senha só nasce pela tela de Usuários, como no Firestore).
    function equipeVideos() {
      return equipe() || (logado() && request.auth.token.firebase.sign_in_provider == 'password' &&
        string(request.auth.token.get('email', '')).lower().matches('.*@roderbrasil[.]com[.]br$'));
    }
    match /consultor_videos/{arquivo} {
      allow read: if logado();
      allow create, update: if equipeVideos() && tamanhoOk(80) &&
        request.resource.contentType.matches('video/(mp4|webm|quicktime)');
      allow delete: if equipeVideos();
    }
    match /consultor_videos/capas/{arquivo} {
      allow read: if logado();
      allow create, update: if equipeVideos() && tamanhoOk(2) &&
        request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow delete: if equipeVideos();
    }

    // Todo o resto (vídeos, orçamentos, documentos): quem tem login de verdade lê e envia;
    // trocar ou apagar arquivo que já existe, só a equipe.
    match /{allPaths=**} {
      allow read: if logado();
      // enviar por cima de um arquivo que já existe conta como troca: só a equipe
      // perfis e notas fiscais têm regra própria acima; aqui não abrem por tabela
      allow create: if logado() && tamanhoOk(600) && (resource == null || equipe()) &&
        !request.resource.name.matches('^(profiles|commissions_nf|consultor_videos)/.*');
      // a biblioteca do consultor tem limite e tipo próprios (acima): aqui não troca por tabela
      allow update: if equipe() && tamanhoOk(600) && !request.resource.name.matches('^consultor_videos/.*');
      allow delete: if equipe();
    }
  }
}
